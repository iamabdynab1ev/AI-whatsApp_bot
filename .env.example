# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v26.0
WHATSAPP_VERIFY_TOKEN=придумай-длинную-строку-для-проверки
META_APP_SECRET=секрет-приложения-meta

# Номер владельца в международном формате, без пробелов и скобок
OWNER_NUMBER=79991234567
# Если оставить пустым, автоматические ответы получают все номера.
# Для тестового режима можно указать номера через запятую.
ALLOWED_NUMBERS=79990000001,79990000002

# Данные владельца для системного промпта
PERSON_NAME=Имя
PERSON_AGE=возраст
PERSON_CITY=город
PERSON_ACTIVITY=работа, учёба или увлечения
PERSON_CHARACTER=спокойный, добрый, с чувством юмора
PERSON_PRONOUNS=ты
DEFAULT_LANGUAGE=русский

# Примеры разделяются строкой |||. Добавь 20–40 реальных сообщений.
STYLE_EXAMPLES=пример сообщения 01|||пример сообщения 02|||пример сообщения 03|||пример сообщения 04|||пример сообщения 05|||пример сообщения 06|||пример сообщения 07|||пример сообщения 08|||пример сообщения 09|||пример сообщения 10|||пример сообщения 11|||пример сообщения 12|||пример сообщения 13|||пример сообщения 14|||пример сообщения 15|||пример сообщения 16|||пример сообщения 17|||пример сообщения 18|||пример сообщения 19|||пример сообщения 20

DATABASE_PATH=bot.sqlite3
LOG_LEVEL=INFO
